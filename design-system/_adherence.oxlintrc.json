{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/reino/**",
              "produto-original/js/**",
              "ui_kits/babel-os/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Exo 2|Inter))/i]",
        "message": "Font not provided by the design system. Available: Exo 2, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|open|children|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: title, value, open, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|description|meta|unlocked|progress|action|key|ref|className|style|children)$/]",
        "message": "<AchievementBadge> doesn't accept that prop. Declared props: icon, name, description, meta, unlocked, progress, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='AffiliateLevel'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|nivel|indicados|proximo|progress|compact|key|ref|className|style|children)$/]",
        "message": "<AffiliateLevel> doesn't accept that prop. Declared props: level, nivel, indicados, proximo, progress, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='AffiliateLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:link|indicados|comissoes|aviso|onCopy|onClose|key|ref|className|style|children)$/]",
        "message": "<AffiliateLink> doesn't accept that prop. Declared props: link, indicados, comissoes, aviso, onCopy, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|gradient|size|className|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, gradient, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:brand|match|noticia)$/]",
        "message": "<Avatar> gradient must be one of 'brand' | 'match' | 'noticia'."
      },
