        "selector": "JSXOpeningElement[name.name='BarMetricItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|percent|color|key|ref|className|style|children)$/]",
        "message": "<BarMetricItem> doesn't accept that prop. Declared props: name, value, percent, color."
